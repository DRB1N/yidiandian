# 复制为 .env.local 后填入真实值

# 数据库：开发用 SQLite；上线换 PostgreSQL 时改这里并把 prisma/schema.prisma 的 provider 改成 postgresql
DATABASE_URL="file:./dev.db"

# 讯飞星辰 Workflow API
# 鉴权格式为：Authorization: Bearer {XF_API_KEY}:{XF_API_SECRET}
XF_ENDPOINT="https://xingchen-api.xf-yun.com/workflow/v1/chat/completions"
XF_FLOW_ID=""
XF_API_KEY=""
XF_API_SECRET=""

# 讯飞不可用时降级到本地模拟（演示/离线开发用，生产设为 false）
XF_ALLOW_MOCK_FALLBACK="true"
